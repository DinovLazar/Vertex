# Contact form — Formspree AJAX endpoint (https://formspree.io/f/xxxxxxx).
# NEXT_PUBLIC_ so the client can submit directly; the endpoint isn't a secret.
NEXT_PUBLIC_VERTEX_FORMSPREE_ENDPOINT=

# Resend (newsletter welcome email + audience). The contact form no longer uses
# Resend — CONTACT_TO_EMAIL was removed when it moved to Formspree.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=info@vertexconsulting.mk

# Anthropic (chat widget, Phase 12). Use ANTHROPIC_API_KEY in production.
ANTHROPIC_AUTH_TOKEN=

# Sanity CMS (Phase 13A). Project ID + dataset come from sanity.io/manage.
# Tokens: Read = Viewer role, Write = Editor role (two separate tokens).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# On-demand ISR revalidation secret (Phase 13A). Any random 32-char string.
REVALIDATE_SECRET=

# Pexels API (Phase 13B). Free tier: 200 req/hr, 20k/month. Get at pexels.com/api.
# Namespaced to VERTEX_* to avoid collisions with unrelated shell env vars.
VERTEX_PEXELS_API_KEY=

# Admin dashboard password (Phase 13B). Any strong ≥16-char string.
# Namespaced to VERTEX_* to avoid shadowing by unrelated shell ADMIN_PASSWORD.
VERTEX_ADMIN_PASSWORD=

# Public site URL — used to call /api/revalidate after publishing (Phase 13B).
# Localhost for dev, https://vertexconsulting.mk in Vercel Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta Graph API (Phase 13C) — Facebook Page + Instagram Business posting.
# Generated via Graph API Explorer with permissions: pages_show_list,
# pages_read_engagement, pages_manage_posts, instagram_basic, instagram_content_publish.
# Token is long-lived (~60 days) — set the issued-at date below for expiry warnings.
VERTEX_META_PAGE_ID=
VERTEX_META_IG_USER_ID=
VERTEX_META_PAGE_ACCESS_TOKEN=
VERTEX_META_TOKEN_ISSUED_AT=

# Telegram bot (Phase 13C) — push notifications to Goran's phone.
# Bot created via @BotFather; chat_id obtained via /getUpdates after first message.
VERTEX_TELEGRAM_BOT_TOKEN=
VERTEX_TELEGRAM_CHAT_ID=
