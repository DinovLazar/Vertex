# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example
# `.env*` does NOT match a dot-less `env.local`, which is easy to create by
# accident and which currently holds live Resend / Anthropic / Sanity tokens.
# The repo is public, so match it explicitly.
env.local
env.*.local

# vercel
.vercel

# claude code local worktrees (transient nested checkouts, never commit)
.claude/worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts

# session-H perf measurement artifacts (local-only, regenerable)
.baseline-bundle.json
.after-bundle.json
.lighthouse-baseline/
.lighthouse-after/
.lighthouse-after-v2/
.lighthouse-retry/
.lh-run.sh
.perf-compare.js

# local review captures (screenshots for visual approval, regenerable)
.artifacts/
